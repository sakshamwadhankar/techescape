# ---------------------------------------------------------------------------
# Spider-Man IEEE Event Platform — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Databases / cache ------------------------------------------------------
DATABASE_URL="postgresql://spiderman:spiderman@localhost:5434/spiderman?schema=public"
REDIS_URL="redis://localhost:6379"

# --- API --------------------------------------------------------------------
API_PORT=4000
# Secret used to sign player + admin JWTs. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated list of origins allowed to call the API in development.
CORS_ORIGINS="http://localhost:3000"

# --- Round / event ----------------------------------------------------------
# Shared PIN every team must enter along with their access code at login.
EVENT_PIN="1123"
# Default duration of a game session, in seconds.
GAME_DURATION_SECONDS=300

# --- Admin ------------------------------------------------------------------
# Admin dashboard credentials. Store the plain password in ADMIN_PASSWORD for
# dev; production should set ADMIN_PASSWORD_HASH (bcrypt) and leave this empty.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
# ADMIN_PASSWORD_HASH=""

# --- Cookies ----------------------------------------------------------------
# Set to true in production so cookies are only sent over HTTPS.
COOKIE_SECURE=false
# Base URL of the web app (used for cookies/CORS in production).
WEB_ORIGIN="http://localhost:3000"

# --- Rate limiting -----------------------------------------------------------
# Requests allowed per IP within RATE_LIMIT_TTL seconds.
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=400
# Set to true when the API sits behind a proxy/CDN (e.g. Cloudflare) so the
# client IP from X-Forwarded-For is used for rate limiting.
TRUST_PROXY=false

# --- OpenAPI / Swagger -------------------------------------------------------
# When true, serve the Swagger UI at /api/docs and expose the OpenAPI spec.
# Keep false in production. Generate docs/openapi.json with:
#   pnpm --filter @spiderman/api openapi:gen
ENABLE_SWAGGER=false

# --- Assets / object storage (S3/R2-compatible) ------------------------------
# CDN base URL for game assets (shadow images, card art). Empty in dev.
ASSET_CDN_URL=""
# S3/R2 credentials — only needed when uploading assets from the API.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
