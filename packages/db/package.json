{
  "name": "@spiderman/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "prisma": {
    "seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@spiderman/types": "workspace:*"
  },
  "devDependencies": {
    "@spiderman/config": "workspace:*",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.9.0",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
